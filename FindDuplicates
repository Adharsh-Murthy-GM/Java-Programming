public class FindDuplicates {
    public static void main(String[] args) {

        int[] arr = {1, 2, 3, 2, 4, 1};

        HashSet<Integer> seen = new HashSet<>();
        HashSet<Integer> duplicates = new LinkedHashSet<>();

        for (int num : arr) {

            if (seen.contains(num)) {
                duplicates.add(num);
            } else {
                seen.add(num);
            }
        }

        System.out.println("Duplicates: " + duplicates);
    }
}
